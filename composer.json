{
  "name": "wexample/php-remote-git",
  "description": "The repositories a git host holds and the commits of each day, from GitHub and GitLab, as php-api clients",
  "version": "1.0.0",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/php-api": ">=5.0.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "autoload": {
    "psr-4": {
      "Wexample\\PhpRemoteGit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\PhpRemoteGit\\Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ]
}
